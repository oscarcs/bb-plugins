{
  "name": "bb-plugin-google-antigravity-acp",
  "version": "0.4.0",
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/model-utils.test.ts test/proxy.test.mjs test/probe.test.mjs",
    "build": "bb plugin build"
  },
  "engines": {
    "bb": ">=0.42",
    "bbPluginSdk": ">=0.4.45"
  },
  "bb": {
    "name": "Google Antigravity (ACP)",
    "description": "Run bb threads on Google Antigravity through the official Antigravity CLI (`agy acp --stdio`) with per-model reasoning levels, multimodal file viewing, BB runtime directory access, Auto mode OS sandboxing, and unsandboxed Full access mode.",
    "branding": {
      "icon": "./icons/google-antigravity.svg"
    },
    "server": "./server.ts",
    "host": "./host.ts"
  },
  "dependencies": {
    "@get-bb/plugin-sdk": "^0.4.50",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  },
  "license": "MIT"
}
